diff --git a/src/core/linux/SDL_evdev.c b/src/core/linux/SDL_evdev.c
index de1b758..b194626 100644
--- a/src/core/linux/SDL_evdev.c
+++ b/src/core/linux/SDL_evdev.c
@@ -207,7 +207,41 @@ int SDL_EVDEV_Init(void)
                     }
                 }
             } else {
-                /* TODO: Scan the devices manually, like a caveman */
+                /* Scan /dev/input/event0..15 directly without libudev */
+                int idx;
+                char path[32];
+                for (idx = 0; idx < 16; ++idx) {
+                    int fd;
+                    unsigned long evbit[NBITS(EV_MAX)];
+                    unsigned long keybit[NBITS(KEY_MAX)];
+                    unsigned long absbit[NBITS(ABS_MAX)];
+                    unsigned long relbit[NBITS(REL_MAX)];
+                    int cls;
+
+                    SDL_snprintf(path, sizeof(path), "/dev/input/event%d", idx);
+                    fd = open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+                    if (fd < 0) {
+                        continue;
+                    }
+                    SDL_zeroa(evbit);
+                    SDL_zeroa(keybit);
+                    SDL_zeroa(absbit);
+                    SDL_zeroa(relbit);
+                    if (ioctl(fd, EVIOCGBIT(0, sizeof(evbit)), evbit) >= 0) {
+                        ioctl(fd, EVIOCGBIT(EV_KEY, sizeof(keybit)), keybit);
+                        ioctl(fd, EVIOCGBIT(EV_ABS, sizeof(absbit)), absbit);
+                        ioctl(fd, EVIOCGBIT(EV_REL, sizeof(relbit)), relbit);
+                        cls = SDL_EVDEV_GuessDeviceClass(evbit, absbit, keybit, relbit);
+                        close(fd);
+                        if ((cls & (SDL_UDEV_DEVICE_MOUSE | SDL_UDEV_DEVICE_KEYBOARD |
+                                    SDL_UDEV_DEVICE_TOUCHSCREEN | SDL_UDEV_DEVICE_TOUCHPAD)) &&
+                            !(cls & SDL_UDEV_DEVICE_JOYSTICK)) {
+                            SDL_EVDEV_device_added(path, cls);
+                        }
+                    } else {
+                        close(fd);
+                    }
+                }
             }
         }
 #endif /* SDL_USE_LIBUDEV */
diff --git a/src/render/SDL_render.c b/src/render/SDL_render.c
index a70d38e..21c5f71 100644
--- a/src/render/SDL_render.c
+++ b/src/render/SDL_render.c
@@ -1014,6 +1014,23 @@ SDL_Renderer *SDL_CreateRenderer(SDL_Window *window, int index, Uint32 flags)
                 }
             }
         }
+#ifdef SDL_VIDEO_DRIVER_RETROFW
+        /* On GPU-less RetroFW devices, gracefully fall back to the software
+         * renderer if an app hardcoded SDL_RENDERER_ACCELERATED. */
+        if (!renderer && (flags & SDL_RENDERER_ACCELERATED)) {
+            Uint32 sw_flags = flags & ~SDL_RENDERER_ACCELERATED;
+            for (index = 0; index < n; ++index) {
+                const SDL_RenderDriver *driver = render_drivers[index];
+
+                if ((driver->info.flags & sw_flags) == sw_flags) {
+                    renderer = driver->CreateRenderer(window, sw_flags);
+                    if (renderer) {
+                        break;
+                    }
+                }
+            }
+        }
+#endif
         if (!renderer) {
             SDL_SetError("Couldn't find matching render driver");
             goto error;
